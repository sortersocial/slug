{:tasks
 {:requires ([babashka.process :as p]
             [clojure.string :as str])

  release
  {:doc "Tag and push a new release"
   :task (fn [args]
           (let [bump-type-or-version (first args)
                 explicit-version (when (and bump-type-or-version
                                             (re-matches #"^\d+\.\d+\.\d+$" bump-type-or-version))
                                    bump-type-or-version)
                 bump-type (if explicit-version
                             "patch"
                             (or bump-type-or-version "patch"))
                 
                 ;; Get latest tag
                 latest-tag (-> (p/process "git tag --sort=-version:refname | head -1" {:out :string})
                                deref
                                :out
                                str/trim)
                 latest-version (if (empty? latest-tag)
                                  "0.0.0"
                                  (str/replace latest-tag #"^v" ""))
                 
                 ;; Bump version
                 bump-version (fn [version bump-type]
                                (let [[major minor patch] (map #(Integer/parseInt %)
                                                               (str/split version #"\."))
                                      [new-major new-minor new-patch]
                                      (case bump-type
                                        "major" [(inc major) 0 0]
                                        "minor" [major (inc minor) 0]
                                        "patch" [major minor (inc patch)]
                                        [major minor (inc patch)])]
                                  (str new-major "." new-minor "." new-patch)))
                 
                 version (if explicit-version
                           (str/replace explicit-version #"^v" "")
                           (bump-version latest-version bump-type))
                 tag (str "v" version)]
             
             ;; Check for clean working tree
             (let [result @(p/process "git diff --quiet && git diff --cached --quiet" {:continue true})]
               (when (not= 0 (:exit result))
                 (println "error: working tree has uncommitted changes — commit or stash first")
                 (System/exit 1)))
             
             ;; Show what we're doing
             (when (not explicit-version)
               (println (str "Latest version: " latest-version))
               (println (str "Bumping " bump-type " version to: " version)))
             
             ;; Create and push tag
             (println (str "Tagging " tag " and pushing to origin..."))
             @(p/process ["git" "tag" "-a" tag "-m" (str "Release " tag)])
             @(p/process ["git" "push" "origin" tag])
             
             (println "")
             (println (str "Done. Tag " tag " pushed."))
             (println "Watch the release workflow at:")
             (println "  https://github.com/sortersocial/slug/actions")
             (println "")
             (println "Once complete, users will get the new binary via: npx slugsocial")))}

  release-help
  {:doc "Show release task usage"
   :task (fn [_]
           (println "Usage:")
           (println "  bb release              # Auto-bump patch version (0.0.15 -> 0.0.16)")
           (println "  bb release patch        # Explicitly bump patch version")
           (println "  bb release minor        # Bump minor version (0.0.15 -> 0.1.0)")
           (println "  bb release major        # Bump major version (0.0.15 -> 1.0.0)")
           (println "  bb release 0.0.2        # Use explicit version")
           (println "")
           (println "What this does:")
           (println "  1. Validates the working tree is clean")
           (println "  2. Creates an annotated git tag vX.Y.Z")
           (println "  3. Pushes the tag to origin/main")
           (println "")
           (println "GitHub Actions (release.yml) then:")
           (println "  - Builds Rust binaries for darwin-arm64, darwin-x64, linux-arm64, linux-x64")
           (println "  - Copies binaries into npm platform packages")
           (println "  - Bumps all package.json versions to match the tag")
           (println "  - Publishes @sortersocial/slugsocial-* platform packages to npm")
           (println "  - Publishes the root `slugsocial` package to npm")
           (println "")
           (println "After ~5 minutes, `npx slugsocial` will pull the new version with the")
           (println "updated GUIDE.sorter (it is embedded in the binary via include_str!)."))}}}
