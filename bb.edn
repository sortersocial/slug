{:paths ["."]
 :deps {}
 :tasks
 {:requires ([babashka.process :as p]
             [clojure.string :as str])

  release
  {:doc "Tag and push a new release. Usage: bb release [patch|minor|major|X.Y.Z]"
   :requires ([scripts.release :as rel])
   :task (apply rel/release *command-line-args*)}

  dev
  {:doc "Run the server locally on http://localhost:8080 (SLUG_KEYS=dev:dev)"
   :task (do
           (deref (p/process ["mkdir" "-p" "dev-data"] {:inherit true}))
           (println "")
           (println "  server: http://localhost:8080")
           (println "  cli:    SLUG_SERVER=http://localhost:8080 npx slugsocial <cmd>")
           (println "          npx slugsocial --server http://localhost:8080 <cmd>")
           (println "")
           (deref (p/process ["cargo" "run" "-p" "slugsocial-server"]
                             {:inherit true
                              :env (merge (into {} (System/getenv))
                                          {"SLUG_DATA_DIR" "dev-data"
                                           "SLUG_KEYS"     "dev:dev"
                                           "PORT"          "8080"
                                           "RUST_LOG"      "info"})})))}

  watch
  {:doc "Hot-reload the server on source changes (requires cargo-watch)"
   :task (do
           (deref (p/process ["mkdir" "-p" "dev-data"] {:inherit true}))
           (println "")
           (println "  server: http://localhost:8080")
           (println "  cli:    SLUG_SERVER=http://localhost:8080 npx slugsocial <cmd>")
           (println "          npx slugsocial --server http://localhost:8080 <cmd>")
           (println "")
           (deref (p/process ["cargo" "watch"
                              "-x" "run -p slugsocial-server"
                              "-w" "server/src"
                              "-w" "types/src"]
                             {:inherit true
                              :env (merge (into {} (System/getenv))
                                          {"SLUG_DATA_DIR" "dev-data"
                                           "SLUG_KEYS"     "dev:dev"
                                           "PORT"          "8080"
                                           "RUST_LOG"      "info"})})))}

  test
  {:doc "Full test suite: integration + auth + grants + invites"
   :requires ([test.integration :as integration]
              [test.auth :as auth]
              [test.grants :as grants]
              [test.invites :as invites])
   :task (do
           (integration/integration)
           (auth/auth-test)
           (grants/grants-test)
           (invites/invites-test))}

  perf
  {:doc "Performance test: concurrent HTTP requests to detect blocking I/O"
   :requires ([scripts.perf :as perf])
   :task (perf/perf)}

  release-help
  {:doc "Show release task usage"
   :task (do
           (println "Usage:")
           (println "  bb release              # Auto-bump patch version (0.0.15 -> 0.0.16)")
           (println "  bb release patch        # Explicitly bump patch version")
           (println "  bb release minor        # Bump minor version (0.0.15 -> 0.1.0)")
           (println "  bb release major        # Bump major version (0.0.15 -> 1.0.0)")
           (println "  bb release 0.0.2        # Use explicit version")
           (println "")
           (println "What this does:")
           (println "  1. Validates the working tree is clean")
           (println "  2. Creates an annotated git tag vX.Y.Z")
           (println "  3. Pushes the tag to origin/main")
           (println "")
           (println "GitHub Actions (release.yml) then:")
           (println "  - Builds Rust binaries for darwin-arm64, darwin-x64, linux-arm64, linux-x64")
           (println "  - Copies binaries into npm platform packages")
           (println "  - Bumps all package.json versions to match the tag")
           (println "  - Publishes @sortersocial/slugsocial-* platform packages to npm")
           (println "  - Publishes the root `slugsocial` package to npm")
           (println "")
           (println "After ~5 minutes, `npx slugsocial` will pull the new version."))}}}
